# ─────────────────────────────────────────────────────────────────────────────
#  DELPHOS · Learning Path Optimizer — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
MANIFEST

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# .env.example is intentionally tracked — it is the safe template

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Data (generated, not source) ──────────────────────────────────────────────
# The JSON graph is auto-generated by build_initial_graph.py.
# Commit it only if you want a reproducible snapshot pinned to a release.
data/skill_graph_v1.json

# ── Test / coverage artifacts ─────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Editor & OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── MindSpore (optional GPU backend) ──────────────────────────────────────────
*.ckpt
*.mindir
*.pb
mindspore_log/

# ── Jupyter (if used for exploration) ────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Docker (if added later) ───────────────────────────────────────────────────
*.env.docker
